{
  "name": "qey-extension",
  "description": "qey – QA-Recorder als Browser-Extension",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ort-runtime.mjs && wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "node scripts/copy-ort-runtime.mjs && wxt build",
    "zip": "node scripts/copy-ort-runtime.mjs && wxt zip",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare && node scripts/copy-ort-runtime.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rrweb": "^2.1.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@wxt-dev/module-react": "^1.2.2",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "8.3.1",
    "wxt": "^0.21.4"
  }
}
